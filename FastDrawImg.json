{
  "id": "FastDrawImg",
  "name": "Fast Draw Image",
  "author": "leddele, Boninall",
  "description": "支持导入图片、粘贴路径、绘制、清空和选区两点取样，快捷键可在本文件的 shortcuts 中配置。",
  "version": "1.3.0",
  "has_pck": true,
  "has_dll": true,
  "dependencies": [],
  "affects_gameplay": false,
  "shortcuts": {
    "importImage": "Ctrl+U",
    "pasteImagePath": "Ctrl+V",
    "drawCurrentImage": "U",
    "clearCurrentImage": "Shift+U",
    "captureSelectionStart": "[",
    "captureSelectionEnd": "]",
    "cancelSelection": "Escape"
  }
}
